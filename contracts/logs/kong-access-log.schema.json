{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/kong-access-log.schema.json",
  "title": "Kong access log record (C2, approved)",
  "contract_version": "0.1.1",
  "status": "approved",
  "frozen": true,
  "approved_by": [
    "Student A - Eya Derouiche",
    "Student B - Aya Fayachi",
    "Student C - Wafe Bziouiche"
  ],
  "verification": "G7 verifies the real Kong 3.9.1 file-log output against these fields. Any mismatch requires a versioned contract change.",
  "version_history": [
    "0.1.0: initial draft field set.",
    "0.1.1: approval metadata added; field set unchanged."
  ],
  "type": "object",
  "required": [
    "client_ip",
    "request",
    "response",
    "latencies",
    "started_at"
  ],
  "properties": {
    "client_ip": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "required": [
        "method",
        "uri"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "integer"
        }
      }
    },
    "latencies": {
      "type": "object",
      "additionalProperties": true
    },
    "consumer": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "route": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "service": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "started_at": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
